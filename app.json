{
  "expo": {
    "name": "MathlyAddicted",
    "slug": "MathlyAddicted",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/transparentMathlyLogo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/transparentMathlyLogo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.millionyearscultivation.MathlyAddicted",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.zenmunist.MathlyAddicted",
      "enableProguardInReleaseBuilds": true,
      "permissions": [
        "com.android.vending.BILLING"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/transparentMathlyLogo.png",
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/transparentMathlyLogo.png",
          "color": "#ffffff"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-6440220869221286~7810530924",
          "iosAppId": "ca-app-pub-6440220869221286~1136547029"
        }
      ],
      "expo-iap",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.2.0",
            "extraMavenRepos": [],
            "enableShrinkResourcesInReleaseBuilds": false
          }
        }
      ]
    ],
    "web": {
      "favicon": "./assets/transparentMathlyLogo.png"
    },
    "extra": {
      "eas": {
        "projectId": "36873c25-2ff3-41a1-bfce-cf656ee94546"
      }
    }
  }
}
